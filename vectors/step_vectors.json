 {
  "name": "channel filter excludes non-matching channel",
  "app": {
   "rules": [
    {
     "predicate": {
      "op": "and",
      "left": {
       "op": "kind",
       "kind": "message"
      },
      "right": {
       "op": "channel",
       "channels": [
        "discord"
       ]
      }
     },
     "overlap": {
      "policy": "queue",
      "bound": 16
     },
     "handler_id": "h3",
     "ack": ""

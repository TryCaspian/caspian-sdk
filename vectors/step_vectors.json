[
 {
  "name": "message matches on_message handler, produces Typing + Host",
  "app": {
   "rules": [
    {
     "predicate": {
      "op": "kind",
      "kind": "message"
     },
     "overlap": {
      "policy": "queue",
      "bound": 16
     },
     "handler_id": "h1",
     "ack": ""
    }
   ]
  },
  "event": {
   "kind": "message",
   "thread_id": "telegram:123",
   "text": "hello",
   "chat_kind": "dm",
   "sender": "user1",
   "message_id": "",
   "attachments": [],
   "blocks": [],
   "reply_to": "",
   "topic_id": "",
   "metadata": {},
   "raw": {}
  },
  "channel_name": "telegram",
  "expected_commands": [
   {
    "tag": "Typing",
    "thread_id": "telegram:123"
   },
   {
    "tag": "Host",
    "handler_id": "h1"
   }
  ],
  "expected_dropped": false
 },

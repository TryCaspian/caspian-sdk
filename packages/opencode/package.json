{
  "name": "caspian-opencode-plugin",
  "version": "0.1.6",
  "description": "OpenCode plugin — bidirectional Caspian messaging (email, Telegram, Discord) with a reliability-critical path",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Caspian <ayushguptadev1@gmail.com>",
  "homepage": "https://trycaspianai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryCaspian/caspian-sdk.git",
    "directory": "packages/opencode"
  },
  "bugs": {
    "url": "https://github.com/TryCaspian/caspian-sdk/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "caspian",
    "email",
    "telegram",
    "discord",
    "notifications",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src/skills",
    "src/commands",
    "bin",
    "opencode.commands.json",
    "README.md",
    "RELIABILITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    }
  },
  "bin": "./bin/setup.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:fault": "bun test tests/fault.test.ts",
    "test:capacity": "bun test tests/capacity.test.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "caspian-sdk": "^0.1.2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.2.1",
    "@types/bun": "latest",
    "@types/node": "^20.14.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}

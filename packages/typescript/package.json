{
  "name": "caspian",
  "version": "0.1.0",
  "description": "Caspian TypeScript SDK — one bot program across channels",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./telegram": "./src/adapters/telegram.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "ci": "bun run typecheck && bun run lint && bun run lint:deps && bun test"
  },
  "keywords": [
    "ai",
    "agents",
    "sdk",
    "telegram",
    "discord",
    "slack"
  ],
  "license": "MIT",
  "homepage": "https://trycaspianai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryCaspian/caspian-sdk.git",
    "directory": "packages/typescript"
  },
  "dependencies": {
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}

{
  "name": "caspian-sdk",
  "version": "1.0.0",
  "description": "Caspian TypeScript SDK \u2014 one bot program across channels",
  "type": "module",
  "exports": {
    ".": {
      "bun": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telegram": {
      "bun": {
        "types": "./src/adapters/telegram.ts",
        "default": "./src/adapters/telegram.ts"
      },
      "types": "./dist/adapters/telegram.d.ts",
      "default": "./dist/adapters/telegram.js"
    },
    "./discord": {
      "bun": {
        "types": "./src/adapters/discord.ts",
        "default": "./src/adapters/discord.ts"
      },
      "types": "./dist/adapters/discord.d.ts",
      "default": "./dist/adapters/discord.js"
    },
    "./slack": {
      "bun": {
        "types": "./src/adapters/slack.ts",
        "default": "./src/adapters/slack.ts"
      },
      "types": "./dist/adapters/slack.d.ts",
      "default": "./dist/adapters/slack.js"
    },
    "./voice": {
      "bun": {
        "types": "./src/adapters/voice.ts",
        "default": "./src/adapters/voice.ts"
      },
      "types": "./dist/adapters/voice.d.ts",
      "default": "./dist/adapters/voice.js"
    },
    "./email": {
      "bun": {
        "types": "./src/adapters/email.ts",
        "default": "./src/adapters/email.ts"
      },
      "types": "./dist/adapters/email.d.ts",
      "default": "./dist/adapters/email.js"
    },
    "./sms": {
      "bun": {
        "types": "./src/adapters/sms.ts",
        "default": "./src/adapters/sms.ts"
      },
      "types": "./dist/adapters/sms.d.ts",
      "default": "./dist/adapters/sms.js"
    },
    "./whatsapp": {
      "bun": {
        "types": "./src/adapters/whatsapp.ts",
        "default": "./src/adapters/whatsapp.ts"
      },
      "types": "./dist/adapters/whatsapp.d.ts",
      "default": "./dist/adapters/whatsapp.js"
    },
    "./messenger": {
      "bun": {
        "types": "./src/adapters/messenger.ts",
        "default": "./src/adapters/messenger.ts"
      },
      "types": "./dist/adapters/messenger.d.ts",
      "default": "./dist/adapters/messenger.js"
    },
    "./imessage": {
      "bun": {
        "types": "./src/adapters/imessage.ts",
        "default": "./src/adapters/imessage.ts"
      },
      "types": "./dist/adapters/imessage.d.ts",
      "default": "./dist/adapters/imessage.js"
    },
    "./x": {
      "bun": {
        "types": "./src/adapters/x.ts",
        "default": "./src/adapters/x.ts"
      },
      "types": "./dist/adapters/x.d.ts",
      "default": "./dist/adapters/x.js"
    },
    "./linear": {
      "bun": {
        "types": "./src/adapters/linear.ts",
        "default": "./src/adapters/linear.ts"
      },
      "types": "./dist/adapters/linear.d.ts",
      "default": "./dist/adapters/linear.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "ci": "bun run typecheck && bun run lint && bun run lint:deps && bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ai",
    "agents",
    "sdk",
    "telegram",
    "discord",
    "slack"
  ],
  "license": "MIT",
  "homepage": "https://trycaspianai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryCaspian/caspian-sdk.git",
    "directory": "packages/typescript"
  },
  "dependencies": {
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}

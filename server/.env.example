# Caspian gateway configuration (env prefix: COMM_). Copy to `.env` and fill in
# what you need. Every setting maps to a field in comm_gateway/config.py.
#
# LOCAL DEV: the defaults run a working gateway with SQLite + the in-memory
# `fake` provider — you can start with almost nothing set. Only fill in provider
# credentials for the channels you actually want to test.
#
# SECRETS: never commit a filled-in .env. In production these are NOT stored
# here — secrets load from AWS SSM at startup (see the SSM sections) and only the
# param NAMES live in the server .env. Values below marked <...> are secrets.

# ── Core ─────────────────────────────────────────────────────────────────────
COMM_DATABASE_URL=sqlite:///./comm.db          # prod uses a Postgres URL (Supabase session pooler)
COMM_PROVIDER=fake                             # single default provider; `fake` = in-memory, no creds
COMM_PROVIDERS=fake                            # comma-separated live providers; overrides COMM_PROVIDER
                                               # prod e.g.: ses,discord,slack,x,telegram,twilio,telnyx
COMM_BOOTSTRAP_API_KEY=comm_test_replace_me    # seeds a default project + api key on first boot
COMM_INLINE_WORKER=true                        # run the outbox worker + listeners in-process
COMM_HOST=127.0.0.1
COMM_PORT=8000
COMM_PUBLIC_BASE_URL=                          # https base for OAuth redirects/webhooks, e.g. https://api.trycaspianai.com

# ── Credential encryption (at-rest) ──────────────────────────────────────────
# Fernet key to encrypt per-connection provider creds. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMM_CREDENTIALS_KEY=                           # <Fernet key> — blank in prod; load from SSM below
COMM_CREDENTIALS_KEY_SSM_PARAM=                 # e.g. /caspian/prod/credentials_key
COMM_CREDENTIALS_KEY_SSM_REGION=ap-south-1

# ── Stripe / billing ─────────────────────────────────────────────────────────
COMM_STRIPE_SECRET_KEY=                         # <sk_...> — blank in prod; load from SSM below
COMM_STRIPE_WEBHOOK_SECRET=                     # <whsec_...> — blank in prod; load from SSM below
COMM_STRIPE_SECRET_KEY_SSM_PARAM=               # e.g. /caspian/prod/stripe_secret_key
COMM_STRIPE_WEBHOOK_SECRET_SSM_PARAM=           # e.g. /caspian/prod/stripe_webhook_secret
COMM_STRIPE_BASE_URL=https://api.stripe.com
COMM_BILLING_CURRENCY=usd
COMM_BILLING_SUCCESS_URL=                        # your Stripe success page
COMM_BILLING_CANCEL_URL=                         # your Stripe cancel page
COMM_BILLING_LOW_BALANCE_CENTS=100              # emit billing.low_balance below this
COMM_BILLING_DASHBOARD_URL=                      # where a 402 points devs to add credit

# ── Dashboard sign-in (Supabase / Google) ────────────────────────────────────
COMM_SUPABASE_URL=                              # https://<ref>.supabase.co
COMM_SUPABASE_ANON_KEY=                         # <anon key> — validates dashboard access tokens
COMM_DASHBOARD_LINKS=                           # JSON {email: project_id} demo mapping (optional)

# ── Email — AWS SES (prod runs in us-east-1; inbound receiving needs a supported region) ──
COMM_SES_REGION=us-east-1
COMM_SES_DOMAIN=                                # e.g. agents.yourco.com (a subdomain; DKIM verified)
COMM_SES_S3_BUCKET=                             # inbound-mail bucket
COMM_SES_TOPIC_ARN=                             # SNS topic ARN(s), comma-separated (inbound[,events])
COMM_SES_VERIFY_SNS=true
COMM_SES_RULE_SET=                              # SES receipt rule set name
COMM_SES_RULE_NAME=                             # SES receipt rule name

# ── Telegram ─────────────────────────────────────────────────────────────────
COMM_TELEGRAM_WEBHOOK_BASE=                     # https://<gateway>/internal/providers/telegram/webhooks
COMM_TELEGRAM_BASE_URL=https://api.telegram.org
COMM_TELEGRAM_USER_SESSION=                     # (user MTProto mode) session string
COMM_TELEGRAM_API_ID=0                          # (user MTProto mode)
COMM_TELEGRAM_API_HASH=                         # (user MTProto mode)

# ── Discord (shared bot for one-click install) ───────────────────────────────
COMM_DISCORD_BASE_URL=https://discord.com/api/v10
COMM_DISCORD_CLIENT_ID=
COMM_DISCORD_CLIENT_SECRET=                     # <secret>
COMM_DISCORD_BOT_TOKEN=                         # <bot token>
COMM_DISCORD_BOT_PERMISSIONS=67177472           # View+Send+History+Change-Nickname

# ── Slack (single app; or a pool for the coalition case) ─────────────────────
COMM_SLACK_CLIENT_ID=
COMM_SLACK_CLIENT_SECRET=                       # <secret>
COMM_SLACK_SIGNING_SECRET=                      # <signing secret>
COMM_SLACK_SCOPES=chat:write,chat:write.customize,channels:history,im:history,app_mentions:read
COMM_SLACK_APPS=                                # JSON list of {app_id,client_id,client_secret,signing_secret}

# ── X (Twitter) — reactive DM bot (OAuth 1.0a) ───────────────────────────────
COMM_X_API_KEY=                                 # consumer key
COMM_X_API_SECRET=                              # <consumer secret> (verifies webhooks / signs CRC)
COMM_X_BEARER_TOKEN=                            # app-only bearer (optional)
COMM_X_ACCESS_TOKEN=                            # fallback account OAuth token (optional)
COMM_X_ACCESS_SECRET=                           # <fallback secret> (optional)
COMM_X_USER_ID=                                 # fallback account numeric id (optional)
COMM_X_WEBHOOK_SECRET=                          # overrides X_API_SECRET for CRC if set
COMM_X_BASE_URL=https://api.x.com
COMM_X_DM_POLL_INTERVAL=10.0                    # seconds between DM polls per connection

# ── WhatsApp / Instagram / Facebook — Meta ───────────────────────────────────
COMM_META_WA_PHONE_NUMBER_ID=
COMM_META_WA_ACCESS_TOKEN=                      # <token>
COMM_META_WA_APP_SECRET=                        # <secret>
COMM_META_WA_VERIFY_TOKEN=
COMM_META_APP_ID=
COMM_META_APP_SECRET=                           # <secret>
COMM_META_ES_CONFIG_ID=                         # Embedded Signup configuration id
COMM_META_GRAPH_VERSION=v21.0
COMM_INSTAGRAM_PAGE_ID=
COMM_INSTAGRAM_ACCESS_TOKEN=                    # <token>
COMM_INSTAGRAM_APP_SECRET=                      # <secret>
COMM_INSTAGRAM_VERIFY_TOKEN=
COMM_FACEBOOK_PAGE_ID=
COMM_FACEBOOK_ACCESS_TOKEN=                     # <token>
COMM_FACEBOOK_APP_SECRET=                       # <secret>
COMM_FACEBOOK_VERIFY_TOKEN=

# ── Twilio (SMS / WhatsApp / RCS / Voice) ────────────────────────────────────
COMM_TWILIO_ACCOUNT_SID=
COMM_TWILIO_AUTH_TOKEN=                          # <token>
COMM_TWILIO_FROM_NUMBER=                         # E.164 SMS sender
COMM_TWILIO_WHATSAPP_FROM=+14155238886           # Twilio WhatsApp sandbox by default
COMM_TWILIO_WHATSAPP_POOL=                        # E.164 pool (comma-separated) for per-agent numbers
COMM_TWILIO_RCS_MESSAGING_SERVICE_SID=
COMM_TWILIO_PROVISION_COUNTRY=US
COMM_TWILIO_PROVISION_AREA_CODE=
COMM_TWILIO_INBOUND_WEBHOOK_URL=

# ── Telnyx (SMS) ─────────────────────────────────────────────────────────────
COMM_TELNYX_API_KEY=                             # <key>
COMM_TELNYX_FROM_NUMBER=
COMM_TELNYX_MESSAGING_PROFILE_ID=
COMM_TELNYX_PUBLIC_KEY=                           # verifies inbound webhooks
COMM_TELNYX_BASE_URL=https://api.telnyx.com

# ── Voice (Twilio Voice + ConversationRelay) ─────────────────────────────────
COMM_VOICE_FROM_NUMBER=                           # shared voice line; blank -> commission per agent
COMM_VOICE_CONVERSATIONRELAY_URL=                 # external realtime-AI WebSocket the call connects to
COMM_VOICE_INBOUND_WEBHOOK_URL=

# ── iMessage — self-hosted BlueBubbles on a Mac mini ─────────────────────────
COMM_MACMINI_BLUEBUBBLES_URL=
COMM_MACMINI_BLUEBUBBLES_PASSWORD=               # <password>
COMM_MACMINI_IMESSAGE_HANDLE=
COMM_MACMINI_WEBHOOK_SECRET=                      # optional; verification enforced only when set

# ── Managed phone (SIM-backed SMS/iMessage provisioning) ─────────────────────
# Bring your own compatible upstream: set the base URL + key. Blank = disabled.
COMM_CASPIAN_PHONE_API_KEY=                       # <key>
COMM_CASPIAN_PHONE_WEBHOOK_SECRET=                # <secret>
COMM_CASPIAN_PHONE_BASE_URL=                      # <https base url of your number provider>

# ── GitHub App (issue/PR comments) ───────────────────────────────────────────
COMM_GITHUB_APP_ID=
COMM_GITHUB_APP_SLUG=
COMM_GITHUB_PRIVATE_KEY=                          # inline PEM or path to .pem
COMM_GITHUB_WEBHOOK_SECRET=
COMM_GITHUB_API_BASE=https://api.github.com

# ── GSM modem (SMS via a physical modem) ─────────────────────────────────────
COMM_MODEM_SERIAL_PORT=
COMM_MODEM_MSISDN=

# ── Product analytics (PostHog) — optional, off unless a key is set ───────────
COMM_TELEMETRY=true                              # set false to hard-disable analytics
COMM_POSTHOG_KEY=                                # phc_... write key; blank = disabled (self-host sends nothing)
COMM_POSTHOG_HOST=https://us.i.posthog.com
